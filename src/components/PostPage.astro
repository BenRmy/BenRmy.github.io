---
import { blogCoverUrl} from '@utils/urlUtils'
import PostCard from '@components/PostCard.astro';
import type { BlogEntryWithLocaleStatus } from '@utils/contentUtils';

const { page } = Astro.props;

---
{page.data.map((entry: BlogEntryWithLocaleStatus, index: number) => (
        <PostCard 
            entry={entry}
            title={entry.data.title} 
            description={entry.data.description} 
            image={blogCoverUrl(entry.data.image, entry.id)}
            pubDate={entry.data.pubDate}
            url={entry.id} 
            fallback={entry.isFallback}
            priority={index === 0}
            delay={Math.min(index, 5) * 50}
        >
        </PostCard>
))}